    # Every hazard on the player's side at battle start: Stealth Rock, Spikes, Toxic Spikes, Sticky Web.
    rule {
      trigger { battle_start {} }
      effect { hazard { kind: STEALTH_ROCK side: RULE_FIELD_SIDE_PLAYER } }
      effect { hazard { kind: SPIKES side: RULE_FIELD_SIDE_PLAYER layers: 1 } }
      effect { hazard { kind: TOXIC_SPIKES side: RULE_FIELD_SIDE_PLAYER layers: 1 } }
      effect { hazard { kind: STICKY_WEB side: RULE_FIELD_SIDE_PLAYER } }
      name: "All Hazards"
      announce: "All hazards were scattered around {B_PLAYER_NAME}'s team!"
    }
  }
}
