    # +4 Def for the lead on entry, +1 Def every turn
    rule {
      trigger { entry { when: LEAD } }
      effect { stat_change { stat: RULE_STAT_DEF amount: 4 } }
      name: "Fortified Lead"
      announce: "{B_TRAINER1_NAME}'s lead Pokémon\\nfortifies its defenses!"
    }
    rule {
      trigger { end_turn {} }
      effect { stat_change { stat: RULE_STAT_DEF amount: 1 } }
      name: "Steady Defense"
