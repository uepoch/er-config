    # Two layers of Toxic Spikes on the player's side at battle start.
    rule {
      trigger { battle_start {} }
      effect { hazard { kind: TOXIC_SPIKES side: RULE_FIELD_SIDE_PLAYER layers: 2 } }
      name: "Toxic Spikes 2x"
      announce: "Two layers of Toxic Spikes scatter on the\\nground around {B_PLAYER_NAME} team!"
    }
    # One layer of Spikes on the player's side at battle start.
    rule {
      trigger { battle_start {} }
      effect { hazard { kind: SPIKES side: RULE_FIELD_SIDE_PLAYER layers: 1 } }
      name: "Spikes 1x"
      announce: "A layer of spikes scatters on the\\nground around {B_PLAYER_NAME}'s team!"
    }
  }
}
