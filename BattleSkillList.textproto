# proto-file: BattleSkillList.proto
# proto-message: er.BattleSkillList

template {
  id: SKILL_TEMPLATE_EXTRA_ABILITY
  name: "Extra Ability"
  valid_params {
    announce_string: "{B_TRAINER1_NAME}'s team gains the\\nability {B_BUFF1}!"
    param {
      ability: ABILITY_NONE
    }
  }
  valid_params {
    announce_string: "{B_TRAINER1_NAME}'s team gains the\\nabilities {B_BUFF1} and {B_BUFF2}!"
    param {
      ability: ABILITY_NONE
    }
    param {
      ability: ABILITY_NONE
    }
  }
  valid_params {
    announce_string: "{B_TRAINER1_NAME}'s team gains the\\nabilities {B_BUFF1}, {B_BUFF2},\\pand {B_BUFF3}!"
    param {
      ability: ABILITY_NONE
    }
    param {
      ability: ABILITY_NONE
    }
    param {
      ability: ABILITY_NONE
    }
  }
  impl {
    id: SKILL_EXTRA_ABILITY_UNNERVE
    param {
      ability: ABILITY_UNNERVE
    }
  }
  impl {
    id: SKILL_EXTRA_ABILITY_INNARDS_OUT
    param {
      ability: ABILITY_INNARDS_OUT
    }
  }
  impl {
    id: SKILL_EXTRA_ABILITY_CUTE_CHARM
    param {
      ability: ABILITY_CUTE_CHARM
    }
  }
  impl {
    id: SKILL_EXTRA_ABILITY_FILTER
    param {
      ability: ABILITY_FILTER
    }
  }
  impl {
    id: SKILL_EXTRA_ABILITY_SWORD_OF_RUIN
    param {
      ability: ABILITY_SWORD_OF_RUIN
    }
  }
  impl {
    id: SKILL_EXTRA_ABILITY_FLASH_FIRE
    param {
      ability: ABILITY_FLASH_FIRE
    }
  }
  impl {
    id: SKILL_EXTRA_ABILITY_SWARM
    param {
      ability: ABILITY_SWARM
    }
  }
  impl {
    id: SKILL_EXTRA_ABILITY_SUPER_LUCK
    param {
      ability: ABILITY_SUPER_LUCK
    }
  }
}

skill {
  id: SKILL_NONE
  name: "---"
}
skill {
  id: SKILL_EVIOLITE
  name: "Eviolite"
  announce_string: "{B_TRAINER1_NAME}'s team is protected by\\nEviolite."
}
skill {
  id: SKILL_ON_ENTRY_LEECH_SEED
  name: "Leech Seed"
  announce_string: "A seed was planted on {B_DEF_NAME_WITH_PREFIX}!"
}
skill {
  id: SKILL_ON_END_TURN_MOVE_JUDGEMENT_60_BP
  name: "Judgement on Turn End"
  announce_string: "{B_TRAINER1_NAME}'s team uses 60 BP Judgement on turn end!"
}
skill {
  id: SKILL_ON_SWITCH_MOVE_PAYDAY
  name: "Payday on Switch"
  announce_string: "{B_TRAINER1_NAME}'s team uses Payday whenever\\na Pokémon switches!"
}
skill {
  id: SKILL_NO_CRIT
  name: "Critical Hit Immunity"
  announce_string: "{B_TRAINER1_NAME}'s team is immune to critical hits!"
}
