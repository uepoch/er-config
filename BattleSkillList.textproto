  id: SKILL_PERMANENT_STICKY_WEB
  name: "Sticky Web"
  announce_string: "A sticky web spreads out on the\\nground around {B_PLAYER_NAME}'s team!"
}
skill {
  id: SKILL_STICKY_WEB_BOTH_SIDES
  name: "Sticky Web"
  announce_string: "Sticky webs spread out on the\\nground around both sides of the field!"
}
